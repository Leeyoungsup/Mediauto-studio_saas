POSTGRES_DEPLOYMENT=docker
POSTGRES_DB=medicus_studio
POSTGRES_USER=mediauto
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432

# Used by the FastAPI backend and Alembic. URL-encode special characters in
# the password, or inject this value from the deployment secret manager.
POSTGRES_URI=postgresql+asyncpg://mediauto:replace-with-a-strong-database-password@localhost:5432/medicus_studio
DATABASE_BACKEND=postgresql
